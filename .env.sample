# Neon PostgreSQL — primary (production)
# Example: postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Fallback MySQL for local dev without DATABASE_URL (optional)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Sundari@05
DB_NAME=fuelbox_db

# JWT Secret — change this in production!
JWT_SECRET=fuelbox_jwt_secret_change_in_production_2026

# Seed endpoint secret — pass as ?secret=VALUE to protect /api/seed
SEED_SECRET=fuelbox_seed_secret_2026

# AI Advisor API Keys (server-side only — do NOT prefix with NEXT_PUBLIC_)
OPENROUTER_API_KEY=sk-or-v1-xxxxx
GROQ_API_KEY=gsk_xxxxx
